{
  "name": "coinvello/sdk",
  "description": "Official CoinVello API client for PHP (non-custodial crypto payments). No Guzzle: ext-curl only.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://coinvello.com/developers",
  "authors": [{ "name": "CoinVello", "email": "support@coinvello.com", "homepage": "https://coinvello.com" }],
  "support": {
    "email": "support@coinvello.com",
    "issues": "https://github.com/CoinVello/coinvello-php/issues",
    "source": "https://github.com/CoinVello/coinvello-php",
    "docs": "https://coinvello.com/developers"
  },
  "keywords": ["coinvello", "crypto", "payments", "bitcoin", "woocommerce", "webhooks"],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": { "CoinVello\\Sdk\\": "src/" }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "scripts": {
    "example": "php examples/create-invoice.php"
  },
  "config": { "sort-packages": true }
}
